  "cards": [
    {
      "dot": "emerald",
      "title": "判断与效果分工",
      "items": [
        "仲裁判能否跳；状态机校验转换；效果提供跳跃倍率。",
        "逻辑负责赋值、Buff 施加与移除；Data 不反向改上层。"
      ]
    },
    {
      "dot": "cyan",
      "title": "技能组合与命中",
      "items": [
        "远程武器暂不开发；已移除射击入口与专用瞄准输入。",
        "自身效果与目标效果分开；目标效果依赖实际命中结果。",
        "V 非零信心起手快照；Logic 按绝对值×K设置绿血及毫秒时长，耗尽归还。状态仅标记，Data不驱动玩法。"
      ]
    },
    {
      "dot": "amber",
      "title": "开发约束与未定接口",
      "items": [
        "Debug 独立执行，仲裁只判断；代码审查通过再做下一功能。",
        "黑板组织、通知与命中返回方式待定；图不代表已实现。"
      ]
    }
  ],
